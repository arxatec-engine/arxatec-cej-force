TARGET_URL=https://cej.pj.gob.pe/cej/forms/busquedaform.html
BROWSER_MODE=local
BROWSER_STARTUP_DELAY_MS=15000
BROWSER_HEADLESS=false
KEEP_BROWSER_OPEN=true
CHROME_PATH=
PROFILE_DIRECTORY=./data/visible-query-profile
COOKIE_FILE=./data/visible-query-cookies.json
OUTPUT_DIRECTORY=./output
USER_AGENT=
TIMEZONE=America/Lima
ACCEPT_LANGUAGE=es-PE,es;q=0.9
NAVIGATION_TIMEOUT_MS=45000
FORM_TIMEOUT_MS=300000
POLL_INTERVAL_MS=1000
HEARTBEAT_INTERVAL_MS=30000
FORM_SELECTOR=form
FORM_REQUIRED_TEXT=Distrito Judicial
ACTIONS_FILE=

# Conexión a un Chrome existente con un perfil dedicado.
CDP_ENDPOINT=http://127.0.0.1:9222
# Conexión Browserless; el token se agrega al endpoint automáticamente.
BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io/chromium
BROWSERLESS_TOKEN=

# manual | ocr | 2captcha. OCR es local; 2Captcha cobra por tarea.
CAPTCHA_MODE=ocr
TWOCAPTCHA_API_KEY=
CAPTCHA_TIMEOUT_MS=120000
# recaptcha | turnstile | image; configurar para el desafío observado.
CAPTCHA_TYPE=image
CAPTCHA_TRIGGER_SELECTOR="#captcha_image"
CAPTCHA_SITE_KEY=
CAPTCHA_RESPONSE_SELECTOR="#codigoCaptcha"
CAPTCHA_IMAGE_SELECTOR="#captcha_image"
CAPTCHA_CALLBACK=
CAPTCHA_SUBMIT_SELECTOR=
OCR_MIN_CONFIDENCE=60
CAPTCHA_AUDIO_FALLBACK=true
OCR_CACHE_DIRECTORY=./data/ocr-cache
QUERY_FILE=./config/cej-query.json
QUERY_TIMEOUT_MS=45000
QUERY_CAPTCHA_ATTEMPTS=3
VALIDATE_IDENTITY=true
IDENTITY_FILE=./data/consultant-identity.json
IDENTITY_TIMEOUT_MS=60000
